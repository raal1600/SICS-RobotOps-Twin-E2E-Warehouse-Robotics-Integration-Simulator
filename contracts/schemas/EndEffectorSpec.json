{
  "$defs": {
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "ToolConstraints": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "flat_top",
            "grasp_width",
            "soft_envelope",
            "under_clearance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum_width_m": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Width M",
          "type": "number"
        },
        "minimum_flat_top_m": {
          "default": [
            0,
            0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Minimum Flat Top M",
          "type": "array"
        },
        "minimum_width_m": {
          "default": 0,
          "minimum": 0,
          "title": "Minimum Width M",
          "type": "number"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ToolConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collision_envelope_m": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      ],
      "title": "Collision Envelope M",
      "type": "array"
    },
    "collision_offset_m": {
      "default": [
        0,
        0,
        0.09
      ],
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Collision Offset M",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/ToolConstraints"
    },
    "display_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "family": {
      "enum": [
        "vacuum",
        "pinch",
        "soft",
        "fork"
      ],
      "title": "Family",
      "type": "string"
    },
    "max_simulated_mass_kg": {
      "exclusiveMinimum": 0,
      "title": "Max Simulated Mass Kg",
      "type": "number"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tcp_transform": {
      "$ref": "#/$defs/Pose"
    },
    "tool_id": {
      "enum": [
        "EE_VAC_SINGLE",
        "EE_VAC_ARRAY",
        "EE_PINCH_NARROW",
        "EE_PINCH_WIDE",
        "EE_ADAPTIVE_SOFT",
        "EE_SUPPORT_FORK"
      ],
      "title": "Tool Id",
      "type": "string"
    },
    "tool_spec_version": {
      "const": "synthetic-tools-1",
      "default": "synthetic-tools-1",
      "title": "Tool Spec Version",
      "type": "string"
    },
    "visual_asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Visual Asset Id",
      "type": "string"
    }
  },
  "required": [
    "tool_id",
    "family",
    "display_name",
    "max_simulated_mass_kg",
    "tcp_transform",
    "collision_envelope_m",
    "constraints",
    "visual_asset_id"
  ],
  "title": "EndEffectorSpec",
  "type": "object"
}
