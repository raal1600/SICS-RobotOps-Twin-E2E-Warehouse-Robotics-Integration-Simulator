{
  "$defs": {
    "JobState": {
      "enum": [
        "RECEIVED",
        "VALIDATED",
        "PLANNING",
        "READY_TO_EXECUTE",
        "EXECUTING",
        "VERIFYING",
        "UNKNOWN_OUTCOME",
        "RECONCILING",
        "COMPLETED",
        "FAILED",
        "REQUIRES_INTERVENTION"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "cell_display_name": {
      "title": "Cell Display Name",
      "type": "string"
    },
    "cell_profile_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Cell Profile Id",
      "type": "string"
    },
    "clearing": {
      "default": false,
      "title": "Clearing",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "number": {
      "title": "Number",
      "type": "integer"
    },
    "order_count": {
      "title": "Order Count",
      "type": "integer"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/JobState"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "test_id",
    "number",
    "created_at",
    "active",
    "order_count",
    "outcomes",
    "cell_profile_id",
    "cell_display_name"
  ],
  "title": "SimulationTest",
  "type": "object"
}
