{
  "$defs": {
    "FaultDefinition": {
      "additionalProperties": false,
      "properties": {
        "affected": {
          "enum": [
            "sensor",
            "tool",
            "configuration",
            "board",
            "limits"
          ],
          "title": "Affected",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "depth_scale",
            "range_as_z",
            "depth_registration",
            "depth_zero",
            "depth_nonfinite",
            "depth_mixed",
            "depth_occluded",
            "units_1000",
            "rgb_crop",
            "sensor_noise",
            "rgb_corner_warp",
            "tool_translation",
            "tool_rotation",
            "restore_sensor",
            "restore_tool",
            "model_focal",
            "model_profile",
            "model_crop",
            "model_resize",
            "model_distortion",
            "restore_model",
            "board_remount",
            "board_dimensions",
            "restore_board_dimensions",
            "board_marker_ids",
            "restore_board_print",
            "missing_reference_limit",
            "restore_limits"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label",
        "description",
        "affected",
        "next_action"
      ],
      "title": "FaultDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/FaultDefinition"
    },
    "fault_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Fault Id",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "ISOLATED_SIMULATION_FAULT",
      "default": "ISOLATED_SIMULATION_FAULT",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "fault_id",
    "camera_id",
    "definition"
  ],
  "title": "FaultRecord",
  "type": "object"
}
