flowchart TD
  received["RECEIVED → VALIDATED<br/>Durable order and job identity"]
  planning["PLANNING → READY_TO_EXECUTE<br/>Typed plan and action validation"]
  executing["EXECUTING → VERIFYING<br/>One original command identity"]
  unknown["UNKNOWN_OUTCOME<br/>Communication loss / uncertain effect"]
  reconciling["RECONCILING<br/>Original journal + fresh observation"]
  completed["COMPLETED<br/>Verified business outcome"]
  intervention["REQUIRES_INTERVENTION<br/>Paused / explicit re-observation"]
  failed["FAILED<br/>Proven failure; never timeout alone"]
  received --> planning
  planning --> executing
  executing --> completed
  executing --> unknown
  unknown --> reconciling
  reconciling --> completed
  reconciling --> intervention
  reconciling --> failed
  intervention -.-> reconciling
