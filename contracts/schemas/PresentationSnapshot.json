{
  "$defs": {
    "CellMode": {
      "enum": [
        "READY",
        "BUSY",
        "FAULTED",
        "ESTOP_LOGICAL",
        "RESETTING",
        "OFFLINE"
      ],
      "title": "CellMode",
      "type": "string"
    },
    "CellState": {
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Causation Id",
          "type": "string"
        },
        "cell_id": {
          "default": "cell-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Cell Id",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "generation": {
          "default": 0,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/CellMode",
          "default": "READY"
        },
        "reason": {
          "default": "INITIALIZED",
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "correlation_id",
        "causation_id",
        "timestamp"
      ],
      "title": "CellState",
      "type": "object"
    },
    "InventoryLocation": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "location_id",
        "pose"
      ],
      "title": "InventoryLocation",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sku": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Sku",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "sku"
      ],
      "title": "Product",
      "type": "object"
    },
    "WorldObject": {
      "additionalProperties": false,
      "properties": {
        "attached": {
          "default": false,
          "title": "Attached",
          "type": "boolean"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "product",
        "location_id",
        "pose"
      ],
      "title": "WorldObject",
      "type": "object"
    },
    "WorldState": {
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Causation Id",
          "type": "string"
        },
        "cell": {
          "$ref": "#/$defs/CellState"
        },
        "correlation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/InventoryLocation"
          },
          "title": "Locations",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/WorldObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "scene_epoch": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Scene Epoch",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "correlation_id",
        "causation_id",
        "timestamp",
        "scene_epoch",
        "step",
        "objects",
        "locations",
        "cell"
      ],
      "title": "WorldState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persisted before execution for human replay; never sensor evidence.",
  "properties": {
    "causation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Causation Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "world": {
      "$ref": "#/$defs/WorldState"
    }
  },
  "required": [
    "run_id",
    "correlation_id",
    "causation_id",
    "timestamp",
    "job_id",
    "world"
  ],
  "title": "PresentationSnapshot",
  "type": "object"
}
