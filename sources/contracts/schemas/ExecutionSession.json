        "order_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "lines"
      ],
      "title": "OrderRequest",
      "type": "object"
    },
