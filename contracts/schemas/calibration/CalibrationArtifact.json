        "max_depth_m": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Max Depth M",
          "type": "number"
        },
        "min_depth_m": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "title": "Min Depth M",
          "type": "number"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
