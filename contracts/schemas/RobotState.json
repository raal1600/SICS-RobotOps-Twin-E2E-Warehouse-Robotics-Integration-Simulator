{
  "$defs": {
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_tool_id": {
      "anyOf": [
        {
          "enum": [
            "EE_VAC_SINGLE",
            "EE_VAC_ARRAY",
            "EE_PINCH_NARROW",
            "EE_PINCH_WIDE",
            "EE_ADAPTIVE_SOFT",
            "EE_SUPPORT_FORK"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Tool Id"
    },
    "kinematic_model_version": {
      "const": "HKM_INSPIRED_VISUAL_KINEMATICS_V1",
      "default": "HKM_INSPIRED_VISUAL_KINEMATICS_V1",
      "title": "Kinematic Model Version",
      "type": "string"
    },
    "motion_phase": {
      "default": "HOME",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Motion Phase",
      "type": "string"
    },
    "robot_profile_version": {
      "const": "hkm_inspired_v1",
      "default": "hkm_inspired_v1",
      "title": "Robot Profile Version",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tcp_pose": {
      "$ref": "#/$defs/Pose"
    }
  },
  "required": [
    "tcp_pose",
    "active_tool_id"
  ],
  "title": "RobotState",
  "type": "object"
}
