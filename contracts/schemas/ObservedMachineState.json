{
  "$defs": {
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "ToolState": {
      "additionalProperties": false,
      "properties": {
        "active_tool_id": {
          "anyOf": [
            {
              "enum": [
                "EE_VAC_SINGLE",
                "EE_VAC_ARRAY",
                "EE_PINCH_NARROW",
                "EE_PINCH_WIDE",
                "EE_ADAPTIVE_SOFT",
                "EE_SUPPORT_FORK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Tool Id"
        },
        "changer_state": {
          "default": "READY",
          "enum": [
            "READY",
            "CHANGING",
            "FAULTED"
          ],
          "title": "Changer State",
          "type": "string"
        },
        "rack_tool_ids": {
          "items": {
            "enum": [
              "EE_VAC_SINGLE",
              "EE_VAC_ARRAY",
              "EE_PINCH_NARROW",
              "EE_PINCH_WIDE",
              "EE_ADAPTIVE_SOFT",
              "EE_SUPPORT_FORK"
            ],
            "type": "string"
          },
          "title": "Rack Tool Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_state_version": {
          "const": "synthetic-tool-state-1",
          "default": "synthetic-tool-state-1",
          "title": "Tool State Version",
          "type": "string"
        }
      },
      "required": [
        "active_tool_id",
        "rack_tool_ids"
      ],
      "title": "ToolState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "cell_generation": {
      "minimum": 0,
      "title": "Cell Generation",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "SIMULATED_CELL_TELEMETRY",
      "default": "SIMULATED_CELL_TELEMETRY",
      "title": "Source",
      "type": "string"
    },
    "tcp_pose": {
      "$ref": "#/$defs/Pose"
    },
    "tool_state": {
      "$ref": "#/$defs/ToolState"
    }
  },
  "required": [
    "tool_state",
    "tcp_pose",
    "captured_at",
    "cell_generation"
  ],
  "title": "ObservedMachineState",
  "type": "object"
}
