          "type": "array"
        },
        "corners_m": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Corners M",
          "type": "array"
        },
        "dictionary": {
          "const": "DICT_4X4_100",
          "default": "DICT_4X4_100",
