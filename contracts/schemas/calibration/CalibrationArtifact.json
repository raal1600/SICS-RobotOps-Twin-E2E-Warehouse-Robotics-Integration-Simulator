      "title": "ApprovalRecord",
      "type": "object"
    },
    "Board": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "default": "charuco-7x5",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
