{
  "$defs": {
    "Tool": {
      "additionalProperties": false,
      "properties": {
        "configuration_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Configuration Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "t_f_tcp": {
          "$ref": "#/$defs/Transform"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "verification_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Id"
        }
      },
      "required": [
        "tool_id",
        "configuration_revision",
        "t_f_tcp"
      ],
      "title": "Tool",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
