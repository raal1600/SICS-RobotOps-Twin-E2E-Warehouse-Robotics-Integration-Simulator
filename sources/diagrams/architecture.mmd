flowchart TD
  erp["ERP / WMS<br/>Current test / preserved history"]
  core["Integration API / test scope<br/>Active writes / read-only history"]
  gateway["RobotGateway<br/>Typade kommandon och status"]
  brain["Brain-adapter<br/>Planförslag • ingen exekvering"]
  db["Beständig lagring<br/>Test catalog / per-test evidence"]
  world["Blender-runtime<br/>World • separate controller journal"]
  monitor["Operationsvy<br/>Order- och feltidslinje"]
  verify["Verifierare<br/>Observation → bedömning"]
  cell["CellController<br/>READY • ESTOP_LOGICAL • FAULTED"]
  observation["ObservationModel<br/>WorldState → WorldObservation"]
  replay["3D scenario replay<br/>Start scene / events / Blender poses"]
  erp <--> core
  core <--> gateway
  core <--> db
  gateway <--> world
  world <--> cell
  verify --> db
  verify --> monitor
  brain <--> core
  cell -.-> gateway
  world --> observation
  observation --> verify
  world -.-> replay
  replay -.-> erp
  db -.-> replay
