{
  "$defs": {
    "FitResidual": {
      "additionalProperties": false,
      "properties": {
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rotation_deg": {
          "minimum": 0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "translation_mm": {
          "minimum": 0,
          "title": "Translation Mm",
          "type": "number"
        }
      },
      "required": [
        "sample_id",
        "translation_mm",
        "rotation_deg",
        "included",
        "reason"
      ],
      "title": "FitResidual",
      "type": "object"
    },
    "RobustFitPolicy": {
      "additionalProperties": false,
      "properties": {
        "hypothesis_count": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Hypothesis Count",
          "type": "integer"
        },
        "justification": {
          "default": "Training-only consensus uses frozen chain mm/degree limits separately; reject excessive contamination, then require retained pose coverage and unused independent validation.",
          "title": "Justification",
          "type": "string"
        },
        "max_rejection_fraction": {
          "default": 0.25,
          "exclusiveMaximum": 0.5,
          "minimum": 0,
          "title": "Max Rejection Fraction",
          "type": "number"
        },
        "policy_id": {
          "const": "synthetic-training-consensus-1",
          "default": "synthetic-training-consensus-1",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "SIMULATION_ONLY",
          "default": "SIMULATION_ONLY",
          "title": "Scope",
          "type": "string"
        },
        "seed": {
          "default": 1147,
          "title": "Seed",
          "type": "integer"
        },
        "subset_size": {
          "default": 6,
          "maximum": 10,
          "minimum": 3,
          "title": "Subset Size",
          "type": "integer"
        }
      },
      "title": "RobustFitPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "consensus_sample_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "title": "Consensus Sample Ids",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/RobustFitPolicy"
    },
    "residuals": {
      "items": {
        "$ref": "#/$defs/FitResidual"
      },
      "title": "Residuals",
      "type": "array"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_rule": {
      "default": "Largest training consensus; tie: lowest median max(translation/translation_limit, angle/angle_limit). No holdout data used.",
      "title": "Selection Rule",
      "type": "string"
    },
    "tested_hypotheses": {
      "minimum": 1,
      "title": "Tested Hypotheses",
      "type": "integer"
    },
    "valid_hypotheses": {
      "minimum": 1,
      "title": "Valid Hypotheses",
      "type": "integer"
    }
  },
  "required": [
    "policy",
    "tested_hypotheses",
    "valid_hypotheses",
    "consensus_sample_ids",
    "residuals"
  ],
  "title": "FitDiagnostics",
  "type": "object"
}
