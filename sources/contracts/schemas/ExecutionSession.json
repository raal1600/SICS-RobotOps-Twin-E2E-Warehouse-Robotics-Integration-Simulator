    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "default": "WAITING_AUTHORIZATION",
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "default": [],
