{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "IN_PROCESS_PYTHON",
          "default": "IN_PROCESS_PYTHON",
          "title": "Classification",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "function": {
          "title": "Function",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "function",
        "formula",
        "inputs",
        "outputs",
        "decision"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "image_fraction": {
          "title": "Image Fraction",
          "type": "number"
        },
        "rotation_singular_values_rad": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Singular Values Rad",
          "type": "array"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "translation_span_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translation Span M",
          "type": "array"
        }
      },
      "required": [
        "sample_count",
        "translation_span_m",
        "rotation_singular_values_rad",
        "image_fraction",
        "failures"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "MeasurementRejection": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calculation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "acquisition",
            "board_pose",
            "depth"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "reason",
        "detail",
        "stage"
      ],
      "title": "MeasurementRejection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_capture_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "title": "Accepted Capture Ids",
      "type": "array"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "capture_count": {
      "title": "Capture Count",
      "type": "integer"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "dataset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "limits_fingerprint": {
      "title": "Limits Fingerprint",
      "type": "string"
    },
    "next_action": {
      "title": "Next Action",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "ready_to_fit": {
      "title": "Ready To Fit",
      "type": "boolean"
    },
    "rejections": {
      "items": {
        "$ref": "#/$defs/MeasurementRejection"
      },
      "title": "Rejections",
      "type": "array"
    },
    "report_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "Measurement quality only; does not create a candidate or approve calibration",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "plan_id",
    "dataset_id",
    "camera_id",
    "capture_count",
    "limits_fingerprint",
    "accepted_capture_ids",
    "rejections",
    "coverage",
    "ready_to_fit",
    "next_action"
  ],
  "title": "AcquisitionReport",
  "type": "object"
}
