{
  "$defs": {
    "VisualTransform": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "scale": {
          "default": [
            1,
            1,
            1
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Scale",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "position",
        "quaternion_xyzw"
      ],
      "title": "VisualTransform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_tool_id": {
      "anyOf": [
        {
          "enum": [
            "EE_VAC_SINGLE",
            "EE_VAC_ARRAY",
            "EE_PINCH_NARROW",
            "EE_PINCH_WIDE",
            "EE_ADAPTIVE_SOFT",
            "EE_SUPPORT_FORK"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Tool Id"
    },
    "attached_product_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attached Product Id"
    },
    "frame": {
      "maximum": 720,
      "minimum": 1,
      "title": "Frame",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "APPROACH",
        "ATTACH",
        "LIFT",
        "TRANSFER",
        "DETACH",
        "RETRACT",
        "HOME",
        "TOOL_CHANGE_REQUESTED",
        "MOVE_TO_SAFE_POSE",
        "MOVE_TO_TOOL_DOCK",
        "RELEASE_CURRENT_TOOL",
        "VERIFY_FLANGE_EMPTY",
        "ENGAGE_REQUESTED_TOOL",
        "VERIFY_TOOL_ID",
        "RETREAT_FROM_TOOL_RACK",
        "TOOL_CHANGE_COMPLETED",
        "TOOL_CHANGE_NOT_REQUIRED",
        "PRE_GRASP",
        "GRASP",
        "GRASP_CONFIRM",
        "SAFE_TRANSFER",
        "PRE_PLACE",
        "PLACE",
        "RELEASE",
        "RELEASE_CONFIRM",
        "NEXT_SAFE_POSE"
      ],
      "title": "Phase",
      "type": "string"
    },
    "positions": {
      "additionalProperties": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Positions",
      "type": "object"
    },
    "rack_tool_ids": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "EE_VAC_SINGLE",
              "EE_VAC_ARRAY",
              "EE_PINCH_NARROW",
              "EE_PINCH_WIDE",
              "EE_ADAPTIVE_SOFT",
              "EE_SUPPORT_FORK"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rack Tool Ids"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "sim_time_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sim Time S"
    },
    "transforms": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/VisualTransform"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transforms"
    }
  },
  "required": [
    "frame",
    "phase",
    "positions"
  ],
  "title": "VisualFrame",
  "type": "object"
}
