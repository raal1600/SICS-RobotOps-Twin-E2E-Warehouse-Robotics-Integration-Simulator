          "type": "string"
        },
        "marker_length_m": {
          "default": 0.0315,
          "exclusiveMinimum": 0,
          "title": "Marker Length M",
          "type": "number"
        },
        "measured_dimensions_m": {
          "default": [
            0.315,
            0.225
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Measured Dimensions M",
          "type": "array"
        },
        "mounting_id": {
          "default": "flange-mount-1",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Mounting Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "square_length_m": {
          "default": 0.045,
          "maximum": 0.2,
          "minimum": 0.005,
          "title": "Square Length M",
          "type": "number"
        },
        "squares_x": {
          "default": 7,
          "maximum": 20,
          "minimum": 3,
          "title": "Squares X",
          "type": "integer"
        },
        "squares_y": {
          "default": 5,
          "maximum": 20,
          "minimum": 3,
          "title": "Squares Y",
          "type": "integer"
        }
      },
      "required": [
        "corner_ids",
        "corners_m"
      ],
      "title": "Board",
      "type": "object"
    },
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "IN_PROCESS_PYTHON",
          "default": "IN_PROCESS_PYTHON",
          "title": "Classification",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "function": {
          "title": "Function",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
