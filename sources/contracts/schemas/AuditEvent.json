{
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Causation Id",
      "type": "string"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "component": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Component",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Event Type",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[\\w.:-]+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "job_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "order_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Id"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "state_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State After"
    },
    "state_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State Before"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "correlation_id",
    "causation_id",
    "timestamp",
    "event_id",
    "component",
    "event_type",
    "reason"
