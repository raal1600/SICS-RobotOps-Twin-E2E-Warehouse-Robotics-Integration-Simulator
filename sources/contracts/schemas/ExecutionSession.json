      "title": "Command Id"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_stage": {
      "default": 1,
      "title": "Current Stage",
      "type": "integer"
