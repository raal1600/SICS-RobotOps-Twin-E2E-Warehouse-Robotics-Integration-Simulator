{
  "$defs": {
    "ArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_fingerprint": {
          "title": "Artifact Fingerprint",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "camera_configuration_fingerprint": {
          "title": "Camera Configuration Fingerprint",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "artifact_id",
        "artifact_fingerprint",
        "camera_configuration_fingerprint",
        "capture_id"
      ],
      "title": "ArtifactBinding",
      "type": "object"
    },
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "IN_PROCESS_PYTHON",
          "default": "IN_PROCESS_PYTHON",
          "title": "Classification",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "function": {
          "title": "Function",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "function",
        "formula",
        "inputs",
        "outputs",
        "decision"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "MeasurementQuality": {
      "additionalProperties": false,
      "properties": {
        "agreement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Agreement Id",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "confidence_estimate": {
          "const": "NOT_ESTIMATED",
          "default": "NOT_ESTIMATED",
          "title": "Confidence Estimate",
          "type": "string"
        },
        "correspondence_error_px": {
          "minimum": 0,
          "title": "Correspondence Error Px",
          "type": "number"
        },
        "correspondence_limit_px": {
          "exclusiveMinimum": 0,
          "title": "Correspondence Limit Px",
          "type": "number"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "overlap_difference_mm": {
          "minimum": 0,
          "title": "Overlap Difference Mm",
          "type": "number"
        },
        "overlap_limit_mm": {
          "exclusiveMinimum": 0,
          "title": "Overlap Limit Mm",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "point_fingerprint": {
          "title": "Point Fingerprint",
          "type": "string"
        },
        "point_uncertainty_estimate": {
          "const": "NOT_ESTIMATED",
          "default": "NOT_ESTIMATED",
          "title": "Point Uncertainty Estimate",
          "type": "string"
        },
        "quality_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Quality Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "default": "Measured gate results for this synthetic color-coded object, not a statistical probability or point uncertainty bound. Holdout error and acceptance limits are not fresh-point accuracy guarantees.",
          "title": "Scope",
          "type": "string"
        },
        "selected_pixel_count": {
          "exclusiveMinimum": 0,
          "title": "Selected Pixel Count",
          "type": "integer"
        },
        "surface_mask_sha256": {
          "title": "Surface Mask Sha256",
          "type": "string"
        },
        "validation_limit_mm": {
          "exclusiveMinimum": 0,
          "title": "Validation Limit Mm",
          "type": "number"
        },
        "validation_reference_max_mm": {
          "minimum": 0,
          "title": "Validation Reference Max Mm",
          "type": "number"
        }
      },
      "required": [
        "quality_id",
        "camera_id",
        "capture_id",
        "artifact_id",
        "point_fingerprint",
        "surface_mask_sha256",
        "selected_pixel_count",
        "agreement_id",
        "correspondence_error_px",
        "correspondence_limit_px",
        "overlap_difference_mm",
        "overlap_limit_mm",
        "validation_reference_max_mm",
        "validation_limit_mm",
        "passed",
        "failures"
      ],
      "title": "MeasurementQuality",
      "type": "object"
    },
    "PointMeasurement": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "configuration_fingerprint": {
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "frame": {
          "const": "b",
          "default": "b",
          "title": "Frame",
          "type": "string"
        },
        "native_depth_pixel": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Native Depth Pixel",
          "type": "array"
        },
        "point": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Point",
          "type": "array"
        },
        "raw_depth_value": {
          "title": "Raw Depth Value",
          "type": "number"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_rgb_pixel": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Selected Rgb Pixel",
          "type": "array"
        },
        "transform_fingerprint": {
          "title": "Transform Fingerprint",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "point",
        "camera_id",
        "configuration_fingerprint",
        "transform_fingerprint",
        "selected_rgb_pixel",
        "native_depth_pixel",
        "raw_depth_value",
        "calculation"
      ],
      "title": "PointMeasurement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/ArtifactBinding"
    },
    "geometry_assumption": {
      "default": "Known rigid cube, visible top patch; orientation supplied separately by the fixture",
      "title": "Geometry Assumption",
      "type": "string"
    },
    "measurement_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementQuality"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "perception_method": {
      "const": "DECLARED_SYNTHETIC_COLOR_PATCH",
      "default": "DECLARED_SYNTHETIC_COLOR_PATCH",
      "title": "Perception Method",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "surface_point": {
      "$ref": "#/$defs/PointMeasurement"
    }
  },
  "required": [
    "binding",
    "surface_point"
  ],
  "title": "CalibratedObject",
  "type": "object"
}
