{
  "$defs": {
    "OpticalStreamReport": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "image_fraction": {
          "title": "Image Fraction",
          "type": "number"
        },
        "maximum_px": {
          "title": "Maximum Px",
          "type": "number"
        },
        "measurement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Measurement Id",
          "type": "string"
        },
        "point_count": {
          "title": "Point Count",
          "type": "integer"
        },
        "predicted_pixels_px": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Predicted Pixels Px",
          "type": "array"
        },
        "residuals_px": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Residuals Px",
          "type": "array"
        },
        "rms_px": {
          "title": "Rms Px",
          "type": "number"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "enum": [
            "rgb",
            "depth"
          ],
          "title": "Stream",
          "type": "string"
        }
      },
      "required": [
        "measurement_id",
        "stream",
        "point_count",
        "rms_px",
        "maximum_px",
        "image_fraction",
        "predicted_pixels_px",
        "residuals_px",
        "failures"
      ],
      "title": "OpticalStreamReport",
      "type": "object"
    },
    "OpticsLimits": {
      "additionalProperties": false,
      "properties": {
        "justification": {
          "default": "Synthetic reference readout noise is 0.08 px per coordinate. Separate 0.5 px RMS and 1 px maximum gates reserve subpixel model error; these are not SICS or production tolerances.",
          "title": "Justification",
          "type": "string"
        },
        "limits_id": {
          "const": "synthetic-optical-reference-budget-1",
          "default": "synthetic-optical-reference-budget-1",
          "title": "Limits Id",
          "type": "string"
        },
        "max_error_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "title": "Max Error Px"
        },
        "max_rms_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.5,
          "title": "Max Rms Px"
        },
        "min_image_fraction": {
          "default": 0.35,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Min Image Fraction",
          "type": "number"
        },
        "min_points_per_stream": {
          "default": 30,
          "minimum": 12,
          "title": "Min Points Per Stream",
          "type": "integer"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "SIMULATION_ONLY",
          "default": "SIMULATION_ONLY",
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "OpticsLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "camera_configuration_fingerprint": {
      "title": "Camera Configuration Fingerprint",
      "type": "string"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "title": "Failures",
      "type": "array"
    },
    "limitations": {
      "default": [
        "Synthetic factory fixture only; no real camera was measured.",
        "Checks projection for the exact profile and model; does not determine camera-to-robot X.",
        "Does not verify depth scale/semantics, RGB-depth registration, TCP, timing or working-cell mechanics."
      ],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/OpticsLimits"
    },
    "measurement_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Fingerprints",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "report_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/OpticalStreamReport"
      },
      "title": "Streams",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "camera_id",
    "camera_configuration_fingerprint",
    "measurement_fingerprints",
    "limits",
    "streams",
    "passed",
    "failures"
  ],
  "title": "CameraModelReport",
  "type": "object"
}
