      "type": "array"
    },
    "reservation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "reserved_at_utc": {
      "title": "Reserved At Utc",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
