    "resize_xy": {
      "default": [
        1,
        1
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Resize Xy",
      "type": "array"
    },
    "schema_version": {
      "const": "calibration-1.0",
