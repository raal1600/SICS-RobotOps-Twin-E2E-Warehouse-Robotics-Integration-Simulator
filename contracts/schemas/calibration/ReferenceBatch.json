{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "application/x-npy",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Capture": {
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "title": "Admitted",
          "type": "boolean"
        },
        "board_fingerprint": {
          "title": "Board Fingerprint",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "configuration_fingerprint": {
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "depth": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "depth_timestamp_s": {
          "title": "Depth Timestamp S",
          "type": "number"
        },
        "moving": {
          "title": "Moving",
          "type": "boolean"
        },
        "partition": {
          "enum": [
            "fit",
            "validation",
            "routine",
            "runtime"
          ],
          "title": "Partition",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "provenance": {
          "const": "SYNTHETIC_IMAGE_SENSOR",
          "default": "SYNTHETIC_IMAGE_SENSOR",
          "title": "Provenance",
          "type": "string"
        },
        "rejection_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rejection Codes",
          "type": "array"
        },
        "rgb": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "rgb_timestamp_s": {
          "title": "Rgb Timestamp S",
          "type": "number"
        },
        "robot_timestamp_s": {
          "title": "Robot Timestamp S",
          "type": "number"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_fault_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Sensor Fault Ids",
          "type": "array"
        },
        "settled": {
          "title": "Settled",
          "type": "boolean"
        },
        "t_b_f": {
          "$ref": "#/$defs/Transform"
        }
      },
      "required": [
        "capture_id",
        "dataset_id",
        "camera_id",
        "profile_id",
        "configuration_fingerprint",
        "board_fingerprint",
        "rgb",
        "depth",
        "rgb_timestamp_s",
        "depth_timestamp_s",
        "robot_timestamp_s",
        "settled",
        "moving",
        "t_b_f",
        "admitted",
        "partition"
      ],
      "title": "Capture",
      "type": "object"
    },
    "ReferenceCapture": {
      "additionalProperties": false,
      "description": "Independent surveyed fixture coordinate, never reconstructed from the candidate X.",
      "properties": {
        "base_point_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Base Point M",
          "type": "array"
        },
        "capture": {
          "$ref": "#/$defs/Capture"
        },
        "provenance": {
          "const": "SYNTHETIC_INDEPENDENT_SURVEY_FIXTURE",
          "default": "SYNTHETIC_INDEPENDENT_SURVEY_FIXTURE",
          "title": "Provenance",
          "type": "string"
        },
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "base_point_m",
        "capture"
      ],
      "title": "ReferenceCapture",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "enum": [
            "b",
            "f",
            "t",
            "c",
            "d",
            "tcp"
          ],
          "title": "Destination",
          "type": "string"
        },
        "matrix": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Matrix",
          "type": "array"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "b",
            "f",
            "t",
            "c",
            "d",
            "tcp"
          ],
          "title": "Source",
          "type": "string"
        },
        "translation_unit": {
          "const": "m",
          "default": "m",
          "title": "Translation Unit",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "matrix"
      ],
      "title": "Transform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Batch Id",
      "type": "string"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "captures": {
      "items": {
        "$ref": "#/$defs/ReferenceCapture"
      },
      "title": "Captures",
      "type": "array"
    },
    "dataset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "partition": {
      "enum": [
        "validation",
        "routine"
      ],
      "title": "Partition",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "Independent synthetic survey fixtures; reference positions are defined before and without the candidate calibration",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "camera_id",
    "dataset_id",
    "partition",
    "captures"
  ],
  "title": "ReferenceBatch",
  "type": "object"
}
