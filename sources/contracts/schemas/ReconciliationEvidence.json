          "title": "Compatible",
          "type": "boolean"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[\\w.:-]+$",
            "type": "string"
          },
