{
  "$defs": {
    "CellMode": {
      "enum": [
        "READY",
        "BUSY",
        "FAULTED",
        "ESTOP_LOGICAL",
        "RESETTING",
        "OFFLINE"
      ],
      "title": "CellMode",
      "type": "string"
    },
    "CellState": {
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Causation Id",
          "type": "string"
        },
        "cell_id": {
          "default": "cell-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Cell Id",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "generation": {
          "default": 0,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/CellMode",
          "default": "READY"
        },
        "reason": {
          "default": "INITIALIZED",
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "correlation_id",
        "causation_id",
        "timestamp"
      ],
      "title": "CellState",
      "type": "object"
    },
    "InventoryLocation": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "location_id",
        "pose"
      ],
      "title": "InventoryLocation",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "sku": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Sku",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "sku"
      ],
      "title": "Product",
      "type": "object"
    },
    "RobotState": {
      "additionalProperties": false,
      "properties": {
        "active_tool_id": {
          "anyOf": [
            {
              "enum": [
                "EE_VAC_SINGLE",
                "EE_VAC_ARRAY",
                "EE_PINCH_NARROW",
                "EE_PINCH_WIDE",
                "EE_ADAPTIVE_SOFT",
                "EE_SUPPORT_FORK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Tool Id"
        },
        "kinematic_model_version": {
          "const": "HKM_INSPIRED_VISUAL_KINEMATICS_V1",
          "default": "HKM_INSPIRED_VISUAL_KINEMATICS_V1",
          "title": "Kinematic Model Version",
          "type": "string"
        },
        "motion_phase": {
          "default": "HOME",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Motion Phase",
          "type": "string"
        },
        "robot_profile_version": {
          "const": "hkm_inspired_v1",
          "default": "hkm_inspired_v1",
          "title": "Robot Profile Version",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tcp_pose": {
          "$ref": "#/$defs/Pose"
        }
      },
      "required": [
        "tcp_pose",
        "active_tool_id"
      ],
      "title": "RobotState",
      "type": "object"
    },
    "ToolState": {
      "additionalProperties": false,
      "properties": {
        "active_tool_id": {
          "anyOf": [
            {
              "enum": [
                "EE_VAC_SINGLE",
                "EE_VAC_ARRAY",
                "EE_PINCH_NARROW",
                "EE_PINCH_WIDE",
                "EE_ADAPTIVE_SOFT",
                "EE_SUPPORT_FORK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Tool Id"
        },
        "changer_state": {
          "default": "READY",
          "enum": [
            "READY",
            "CHANGING",
            "FAULTED"
          ],
          "title": "Changer State",
          "type": "string"
        },
        "rack_tool_ids": {
          "items": {
            "enum": [
              "EE_VAC_SINGLE",
              "EE_VAC_ARRAY",
              "EE_PINCH_NARROW",
              "EE_PINCH_WIDE",
              "EE_ADAPTIVE_SOFT",
              "EE_SUPPORT_FORK"
            ],
            "type": "string"
          },
          "title": "Rack Tool Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_state_version": {
          "const": "synthetic-tool-state-1",
          "default": "synthetic-tool-state-1",
          "title": "Tool State Version",
          "type": "string"
        }
      },
      "required": [
        "active_tool_id",
        "rack_tool_ids"
      ],
      "title": "ToolState",
      "type": "object"
    },
    "WorldObject": {
      "additionalProperties": false,
      "properties": {
        "attached": {
          "default": false,
          "title": "Attached",
          "type": "boolean"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "product",
        "location_id",
        "pose"
      ],
      "title": "WorldObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Causation Id",
      "type": "string"
    },
    "cell": {
      "$ref": "#/$defs/CellState"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "frame_tree_version": {
      "anyOf": [
        {
          "const": "hkm-frame-tree-1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Tree Version"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/InventoryLocation"
      },
      "title": "Locations",
      "type": "array"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/WorldObject"
      },
      "title": "Objects",
      "type": "array"
    },
    "product_catalog_version": {
      "anyOf": [
        {
          "const": "synthetic-products-1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Catalog Version"
    },
    "robot_profile_version": {
      "anyOf": [
        {
          "const": "hkm_inspired_v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robot Profile Version"
    },
    "robot_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RobotState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "scene_epoch": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Scene Epoch",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "step": {
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tool_spec_version": {
      "anyOf": [
        {
          "const": "synthetic-tools-1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Spec Version"
    },
    "tool_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "correlation_id",
    "causation_id",
    "timestamp",
    "scene_epoch",
    "step",
    "objects",
    "locations",
    "cell"
  ],
  "title": "WorldState",
  "type": "object"
}
