{
  "$defs": {
    "ToolCandidate": {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "enum": [
            "P",
            "C",
            "N"
          ],
          "title": "Compatibility",
          "type": "string"
        },
        "compatible": {
          "title": "Compatible",
          "type": "boolean"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[\\w.:-]+$",
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "tool_id": {
          "enum": [
            "EE_VAC_SINGLE",
            "EE_VAC_ARRAY",
            "EE_PINCH_NARROW",
            "EE_PINCH_WIDE",
            "EE_ADAPTIVE_SOFT",
            "EE_SUPPORT_FORK"
          ],
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "compatibility",
        "compatible",
        "eligible",
        "score",
        "reasons"
      ],
      "title": "ToolCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessed_mass_kg": {
      "exclusiveMinimum": 0,
      "title": "Assessed Mass Kg",
      "type": "number"
    },
    "candidate_tools": {
      "items": {
        "$ref": "#/$defs/ToolCandidate"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Candidate Tools",
      "type": "array"
    },
    "product_catalog_version": {
      "const": "synthetic-products-1",
      "default": "synthetic-products-1",
      "title": "Product Catalog Version",
      "type": "string"
    },
    "product_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Product Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_tool_id": {
      "enum": [
        "EE_VAC_SINGLE",
        "EE_VAC_ARRAY",
        "EE_PINCH_NARROW",
        "EE_PINCH_WIDE",
        "EE_ADAPTIVE_SOFT",
        "EE_SUPPORT_FORK"
      ],
      "title": "Selected Tool Id",
      "type": "string"
    },
    "selection_version": {
      "const": "deterministic-tool-selector-1",
      "default": "deterministic-tool-selector-1",
      "title": "Selection Version",
      "type": "string"
    },
    "sku": {
      "enum": [
        "SKU-A",
        "SKU-B",
        "SKU-C",
        "SKU-D",
        "SKU-E",
        "SKU-F"
      ],
      "title": "Sku",
      "type": "string"
    },
    "tool_change_required": {
      "title": "Tool Change Required",
      "type": "boolean"
    },
    "tool_spec_version": {
      "const": "synthetic-tools-1",
      "default": "synthetic-tools-1",
      "title": "Tool Spec Version",
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "sku",
    "selected_tool_id",
    "candidate_tools",
    "assessed_mass_kg",
    "tool_change_required"
  ],
  "title": "ToolSelectionDecision",
  "type": "object"
}
