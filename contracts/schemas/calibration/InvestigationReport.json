{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "IN_PROCESS_PYTHON",
          "default": "IN_PROCESS_PYTHON",
          "title": "Classification",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "function": {
          "title": "Function",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "function",
        "formula",
        "inputs",
        "outputs",
        "decision"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "DiagnosticClue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "investigate": {
          "title": "Investigate",
          "type": "string"
        },
        "limitation": {
          "title": "Limitation",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "next_measurement": {
          "title": "Next Measurement",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "observation",
        "investigate",
        "next_measurement",
        "limitation"
      ],
      "title": "DiagnosticClue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calculation": {
      "$ref": "#/$defs/Calculation"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "clues": {
      "items": {
        "$ref": "#/$defs/DiagnosticClue"
      },
      "title": "Clues",
      "type": "array"
    },
    "conclusion": {
      "const": "INSUFFICIENT_EVIDENCE / UNKNOWN_CAUSE",
      "default": "INSUFFICIENT_EVIDENCE / UNKNOWN_CAUSE",
      "title": "Conclusion",
      "type": "string"
    },
    "inputs_fingerprint": {
      "title": "Inputs Fingerprint",
      "type": "string"
    },
    "investigation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Investigation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "Non-authorizing comparison of saved measurements. Clues suggest further checks, not proven causes. Never changes X, depth scale, TCP, limits or approval. A missed pick alone does not establish a calibration fault.",
      "title": "Scope",
      "type": "string"
    },
    "source_fingerprint": {
      "title": "Source Fingerprint",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "validation",
        "routine-check",
        "acquisition-report",
        "tool-verification",
        "rejection",
        "runtime-point-error",
        "pick-outcome"
      ],
      "title": "Source Kind",
      "type": "string"
    }
  },
  "required": [
    "investigation_id",
    "camera_id",
    "inputs_fingerprint",
    "source_kind",
    "source_id",
    "source_fingerprint",
    "clues",
    "calculation"
  ],
  "title": "InvestigationReport",
  "type": "object"
}
