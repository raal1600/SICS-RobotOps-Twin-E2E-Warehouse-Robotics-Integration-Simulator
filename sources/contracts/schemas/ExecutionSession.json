        "type": "string"
      },
      "title": "Job Ids",
      "type": "array"
    },
    "mode": {
      "const": "guided",
      "default": "guided",
      "title": "Mode",
      "type": "string"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "pending_authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingAuthorization"
        },
        {
          "type": "null"
        }
      ],
      "default": null
