{
  "$defs": {
    "ArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_fingerprint": {
          "title": "Artifact Fingerprint",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "camera_configuration_fingerprint": {
          "title": "Camera Configuration Fingerprint",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "artifact_id",
        "artifact_fingerprint",
        "camera_configuration_fingerprint",
        "capture_id"
      ],
      "title": "ArtifactBinding",
      "type": "object"
    },
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "IN_PROCESS_PYTHON",
          "default": "IN_PROCESS_PYTHON",
          "title": "Classification",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "function": {
          "title": "Function",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "function",
        "formula",
        "inputs",
        "outputs",
        "decision"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "CalibratedObject": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/ArtifactBinding"
        },
        "geometry_assumption": {
          "default": "Known rigid cube, visible top patch; orientation supplied separately by the fixture",
          "title": "Geometry Assumption",
          "type": "string"
        },
        "measurement_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "perception_method": {
          "const": "DECLARED_SYNTHETIC_COLOR_PATCH",
          "default": "DECLARED_SYNTHETIC_COLOR_PATCH",
          "title": "Perception Method",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_point": {
          "$ref": "#/$defs/PointMeasurement"
        }
      },
      "required": [
        "binding",
        "surface_point"
      ],
      "title": "CalibratedObject",
      "type": "object"
    },
    "CalibratedObservation": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/ArtifactBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "limitations": {
          "default": [
            "Synthetic RGB-D sensor arrays; known color-coded rigid objects only.",
            "Object orientation and grasp geometry come from the declared fixture, not depth alone."
          ],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "machine": {
          "$ref": "#/$defs/CalibrationMachine"
        },
        "profile": {
          "const": "synthetic_calibration_gantry_v1",
          "default": "synthetic_calibration_gantry_v1",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "machine",
        "bindings"
      ],
      "title": "CalibratedObservation",
      "type": "object"
    },
    "CalibrationMachine": {
      "additionalProperties": false,
      "properties": {
        "board_mounted": {
          "title": "Board Mounted",
          "type": "boolean"
        },
        "command_mode": {
          "default": "flange",
          "enum": [
            "tcp",
            "flange"
          ],
          "title": "Command Mode",
          "type": "string"
        },
        "flange": {
          "$ref": "#/$defs/Transform"
        },
        "motion_phase": {
          "default": "IDLE",
          "title": "Motion Phase",
          "type": "string"
        },
        "profile": {
          "const": "synthetic_calibration_gantry_v1",
          "default": "synthetic_calibration_gantry_v1",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "settled": {
          "default": true,
          "title": "Settled",
          "type": "boolean"
        },
        "tcp": {
          "$ref": "#/$defs/Transform"
        },
        "tool": {
          "$ref": "#/$defs/Tool"
        },
        "tool_verification_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Verification Id"
        }
      },
      "required": [
        "flange",
        "tcp",
        "tool",
        "board_mounted"
      ],
      "title": "CalibrationMachine",
      "type": "object"
    },
    "MeasurementQuality": {
      "additionalProperties": false,
      "properties": {
        "agreement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Agreement Id",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capture Id",
          "type": "string"
        },
        "confidence_estimate": {
          "const": "NOT_ESTIMATED",
          "default": "NOT_ESTIMATED",
          "title": "Confidence Estimate",
          "type": "string"
        },
        "correspondence_error_px": {
          "minimum": 0,
          "title": "Correspondence Error Px",
          "type": "number"
        },
        "correspondence_limit_px": {
          "exclusiveMinimum": 0,
          "title": "Correspondence Limit Px",
          "type": "number"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "overlap_difference_mm": {
          "minimum": 0,
          "title": "Overlap Difference Mm",
          "type": "number"
        },
        "overlap_limit_mm": {
          "exclusiveMinimum": 0,
          "title": "Overlap Limit Mm",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "point_fingerprint": {
          "title": "Point Fingerprint",
          "type": "string"
        },
        "point_uncertainty_estimate": {
          "const": "NOT_ESTIMATED",
          "default": "NOT_ESTIMATED",
          "title": "Point Uncertainty Estimate",
          "type": "string"
        },
        "quality_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Quality Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "default": "Measured gate results for this synthetic color-coded object, not a statistical probability or point uncertainty bound. Holdout error and acceptance limits are not fresh-point accuracy guarantees.",
          "title": "Scope",
          "type": "string"
        },
        "selected_pixel_count": {
          "exclusiveMinimum": 0,
          "title": "Selected Pixel Count",
          "type": "integer"
        },
        "surface_mask_sha256": {
          "title": "Surface Mask Sha256",
          "type": "string"
        },
        "validation_limit_mm": {
          "exclusiveMinimum": 0,
          "title": "Validation Limit Mm",
          "type": "number"
        },
        "validation_reference_max_mm": {
          "minimum": 0,
          "title": "Validation Reference Max Mm",
          "type": "number"
        }
      },
      "required": [
        "quality_id",
        "camera_id",
        "capture_id",
        "artifact_id",
        "point_fingerprint",
        "surface_mask_sha256",
        "selected_pixel_count",
        "agreement_id",
        "correspondence_error_px",
        "correspondence_limit_px",
        "overlap_difference_mm",
        "overlap_limit_mm",
        "validation_reference_max_mm",
        "validation_limit_mm",
        "passed",
        "failures"
      ],
      "title": "MeasurementQuality",
      "type": "object"
    },
    "ObservedMachineState": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "cell_generation": {
          "minimum": 0,
          "title": "Cell Generation",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "SIMULATED_CELL_TELEMETRY",
          "default": "SIMULATED_CELL_TELEMETRY",
          "title": "Source",
          "type": "string"
        },
        "tcp_pose": {
          "$ref": "#/$defs/Pose"
        },
        "tool_state": {
          "$ref": "#/$defs/ToolState"
        }
      },
      "required": [
        "tool_state",
        "tcp_pose",
        "captured_at",
        "cell_generation"
      ],
      "title": "ObservedMachineState",
      "type": "object"
    },
    "ObservedObject": {
      "additionalProperties": false,
      "properties": {
        "calibrated_object": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibratedObject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "evidence_source": {
          "anyOf": [
            {
              "const": "SYNTHETIC_OBSERVATION_MODEL",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Source"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0",
            "3.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[\\w.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "uncertainty_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Uncertainty M"
        }
      },
      "required": [
        "product_id",
        "location_id",
        "pose",
        "confidence"
      ],
      "title": "ObservedObject",
      "type": "object"
    },
    "PointMeasurement": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "configuration_fingerprint": {
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "frame": {
          "const": "b",
          "default": "b",
          "title": "Frame",
          "type": "string"
        },
        "native_depth_pixel": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Native Depth Pixel",
          "type": "array"
        },
        "point": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Point",
          "type": "array"
        },
        "raw_depth_value": {
          "title": "Raw Depth Value",
          "type": "number"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_rgb_pixel": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Selected Rgb Pixel",
          "type": "array"
        },
        "transform_fingerprint": {
          "title": "Transform Fingerprint",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "point",
        "camera_id",
        "configuration_fingerprint",
        "transform_fingerprint",
        "selected_rgb_pixel",
        "native_depth_pixel",
        "raw_depth_value",
        "calculation"
      ],
      "title": "PointMeasurement",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "SensorSpec": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "const": "hkm-cal-1",
          "default": "hkm-cal-1",
          "title": "Calibration Version",
          "type": "string"
        },
        "camera_model_version": {
          "const": "synthetic-orthographic-1",
          "default": "synthetic-orthographic-1",
          "title": "Camera Model Version",
          "type": "string"
        },
        "frame_id": {
          "enum": [
            "camera_operator",
            "camera_overhead",
            "camera_side"
          ],
          "title": "Frame Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "presentation_only": {
          "title": "Presentation Only",
          "type": "boolean"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Sensor Id",
          "type": "string"
        }
      },
      "required": [
        "sensor_id",
        "frame_id",
        "pose",
        "presentation_only"
      ],
      "title": "SensorSpec",
      "type": "object"
    },
    "Tool": {
      "additionalProperties": false,
      "properties": {
        "configuration_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Configuration Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "t_f_tcp": {
          "$ref": "#/$defs/Transform"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "verification_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Id"
        }
      },
      "required": [
        "tool_id",
        "configuration_revision",
        "t_f_tcp"
      ],
      "title": "Tool",
      "type": "object"
    },
    "ToolState": {
      "additionalProperties": false,
      "properties": {
        "active_tool_id": {
          "anyOf": [
            {
              "enum": [
                "EE_VAC_SINGLE",
                "EE_VAC_ARRAY",
                "EE_PINCH_NARROW",
                "EE_PINCH_WIDE",
                "EE_ADAPTIVE_SOFT",
                "EE_SUPPORT_FORK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Tool Id"
        },
        "changer_state": {
          "default": "READY",
          "enum": [
            "READY",
            "CHANGING",
            "FAULTED"
          ],
          "title": "Changer State",
          "type": "string"
        },
        "rack_tool_ids": {
          "items": {
            "enum": [
              "EE_VAC_SINGLE",
              "EE_VAC_ARRAY",
              "EE_PINCH_NARROW",
              "EE_PINCH_WIDE",
              "EE_ADAPTIVE_SOFT",
              "EE_SUPPORT_FORK"
            ],
            "type": "string"
          },
          "title": "Rack Tool Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_state_version": {
          "const": "synthetic-tool-state-1",
          "default": "synthetic-tool-state-1",
          "title": "Tool State Version",
          "type": "string"
        }
      },
      "required": [
        "active_tool_id",
        "rack_tool_ids"
      ],
      "title": "ToolState",
      "type": "object"
    },
