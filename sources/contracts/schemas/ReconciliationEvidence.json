{
  "$defs": {
    "CommandReceipt": {
      "additionalProperties": false,
      "properties": {
        "active_tool_id": {
          "anyOf": [
            {
              "enum": [
                "EE_VAC_SINGLE",
                "EE_VAC_ARRAY",
                "EE_PINCH_NARROW",
                "EE_PINCH_WIDE",
                "EE_ADAPTIVE_SOFT",
                "EE_SUPPORT_FORK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Tool Id"
        },
        "causation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Causation Id",
          "type": "string"
        },
        "command_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "effect_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Effect Count",
          "type": "integer"
        },
        "job_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Job Id",
          "type": "string"
        },
        "journal_durable": {
          "default": true,
          "title": "Journal Durable",
          "type": "boolean"
        },
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_profile_version": {
          "anyOf": [
            {
              "const": "hkm_inspired_v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Profile Version"
        },
        "scene_epoch": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Scene Epoch",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CommandStatus"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tool_change_performed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Change Performed"
        },
        "trajectory_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[\\w.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Id"
        }
      },
      "required": [
        "run_id",
        "correlation_id",
        "causation_id",
        "timestamp",
        "command_id",
        "job_id",
        "scene_epoch",
        "status",
        "reason",
        "effect_count",
        "payload_hash"
      ],
      "title": "CommandReceipt",
      "type": "object"
    },
    "CommandStatus": {
      "enum": [
        "CREATED",
        "DISPATCHED",
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "STATUS_UNKNOWN"
      ],
      "title": "CommandStatus",
      "type": "string"
    },
    "ObservedMachineState": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "cell_generation": {
          "minimum": 0,
          "title": "Cell Generation",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "SIMULATED_CELL_TELEMETRY",
          "default": "SIMULATED_CELL_TELEMETRY",
          "title": "Source",
          "type": "string"
        },
        "tcp_pose": {
          "$ref": "#/$defs/Pose"
        },
        "tool_state": {
          "$ref": "#/$defs/ToolState"
        }
      },
      "required": [
        "tool_state",
        "tcp_pose",
        "captured_at",
        "cell_generation"
      ],
      "title": "ObservedMachineState",
      "type": "object"
    },
    "ObservedObject": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_source": {
          "anyOf": [
            {
              "const": "SYNTHETIC_OBSERVATION_MODEL",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Source"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Location Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[\\w.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "uncertainty_m": {
          "default": 0,
          "minimum": 0,
          "title": "Uncertainty M",
          "type": "number"
        }
      },
      "required": [
        "product_id",
        "location_id",
        "pose",
        "confidence"
      ],
      "title": "ObservedObject",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
