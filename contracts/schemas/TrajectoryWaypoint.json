{
  "$defs": {
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "default": "cal-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "frame_id": {
          "default": "cell_world",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion_xyzw": {
          "default": [
            0,
            0,
            0,
            1
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion Xyzw",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_tool_id": {
      "anyOf": [
        {
          "enum": [
            "EE_VAC_SINGLE",
            "EE_VAC_ARRAY",
            "EE_PINCH_NARROW",
            "EE_PINCH_WIDE",
            "EE_ADAPTIVE_SOFT",
            "EE_SUPPORT_FORK"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Tool Id"
    },
    "attached": {
      "default": false,
      "title": "Attached",
      "type": "boolean"
    },
    "phase": {
      "enum": [
        "HOME",
        "TOOL_CHANGE_REQUESTED",
        "MOVE_TO_SAFE_POSE",
        "MOVE_TO_TOOL_DOCK",
        "RELEASE_CURRENT_TOOL",
        "VERIFY_FLANGE_EMPTY",
        "ENGAGE_REQUESTED_TOOL",
        "VERIFY_TOOL_ID",
        "RETREAT_FROM_TOOL_RACK",
        "TOOL_CHANGE_COMPLETED",
        "TOOL_CHANGE_NOT_REQUIRED",
        "PRE_GRASP",
        "APPROACH",
        "GRASP",
        "GRASP_CONFIRM",
        "LIFT",
        "SAFE_TRANSFER",
        "PRE_PLACE",
        "PLACE",
        "RELEASE",
        "RELEASE_CONFIRM",
        "RETRACT",
        "NEXT_SAFE_POSE"
      ],
      "title": "Phase",
      "type": "string"
    },
    "pose": {
      "$ref": "#/$defs/Pose"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sim_time_s": {
      "minimum": 0,
      "title": "Sim Time S",
      "type": "number"
    }
  },
  "required": [
    "phase",
    "pose",
    "sim_time_s",
    "active_tool_id"
  ],
  "title": "TrajectoryWaypoint",
  "type": "object"
}
