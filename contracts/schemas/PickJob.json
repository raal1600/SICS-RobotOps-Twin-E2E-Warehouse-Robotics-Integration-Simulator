{
  "$defs": {
    "JobState": {
      "enum": [
        "RECEIVED",
        "VALIDATED",
        "PLANNING",
        "READY_TO_EXECUTE",
        "EXECUTING",
        "VERIFYING",
        "UNKNOWN_OUTCOME",
        "RECONCILING",
        "COMPLETED",
        "FAILED",
        "REQUIRES_INTERVENTION"
      ],
      "title": "JobState",
      "type": "string"
    },
    "OrderLine": {
      "additionalProperties": false,
      "properties": {
        "destination_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Destination Id",
          "type": "string"
        },
        "order_line_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Order Line Id",
          "type": "string"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "const": 1,
          "default": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "order_line_id",
        "product_id",
        "source_id",
        "destination_id"
      ],
      "title": "OrderLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_plan_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Plan Id"
    },
    "causation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Causation Id",
      "type": "string"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Job Id",
      "type": "string"
    },
    "line": {
      "$ref": "#/$defs/OrderLine"
    },
    "order_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Order Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/JobState",
      "default": "RECEIVED"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "correlation_id",
    "causation_id",
    "timestamp",
    "job_id",
    "order_id",
    "line"
  ],
  "title": "PickJob",
  "type": "object"
}
