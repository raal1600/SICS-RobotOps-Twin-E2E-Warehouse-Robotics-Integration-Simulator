{
  "$defs": {
    "OrderLine": {
      "additionalProperties": false,
      "properties": {
        "destination_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Destination Id",
          "type": "string"
        },
        "order_line_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Order Line Id",
          "type": "string"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "const": 1,
          "default": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "order_line_id",
        "product_id",
        "source_id",
        "destination_id"
      ],
      "title": "OrderLine",
      "type": "object"
    },
    "OrderRequest": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "items": {
            "$ref": "#/$defs/OrderLine"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "order_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[\\w.:-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "lines"
      ],
      "title": "OrderRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fault": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fault"
    },
    "mode": {
      "const": "guided",
      "default": "guided",
      "title": "Mode",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/OrderRequest"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request",
    "request_id"
  ],
  "title": "CreateSession",
  "type": "object"
}
