          "enum": [
            "b",
            "f",
            "t",
            "c",
            "d",
            "tcp"
          ],
          "title": "Destination",
          "type": "string"
        },
        "matrix": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Matrix",
          "type": "array"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "b",
            "f",
            "t",
            "c",
            "d",
            "tcp"
          ],
          "title": "Source",
          "type": "string"
        },
        "translation_unit": {
          "const": "m",
          "default": "m",
          "title": "Translation Unit",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "matrix"
      ],
      "title": "Transform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "board_mounted": {
      "title": "Board Mounted",
      "type": "boolean"
    },
    "command_mode": {
      "default": "flange",
      "enum": [
        "tcp",
        "flange"
      ],
      "title": "Command Mode",
      "type": "string"
    },
    "flange": {
      "$ref": "#/$defs/Transform"
    },
    "motion_phase": {
      "default": "IDLE",
      "title": "Motion Phase",
      "type": "string"
    },
    "profile": {
      "const": "synthetic_calibration_gantry_v1",
      "default": "synthetic_calibration_gantry_v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settled": {
      "default": true,
      "title": "Settled",
      "type": "boolean"
    },
    "tcp": {
      "$ref": "#/$defs/Transform"
    },
    "tool": {
      "$ref": "#/$defs/Tool"
    },
    "tool_verification_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Verification Id"
    }
  },
  "required": [
    "flange",
    "tcp",
    "tool",
    "board_mounted"
  ],
  "title": "CalibrationMachine",
  "type": "object"
}
