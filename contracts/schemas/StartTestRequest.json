{
  "additionalProperties": false,
  "properties": {
    "cell_profile_id": {
      "default": "hkm_inspired_v1",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Cell Profile Id",
      "type": "string"
    },
    "command_mode": {
      "anyOf": [
        {
          "enum": [
            "tcp",
            "flange"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Mode"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "request_id"
  ],
  "title": "StartTestRequest",
  "type": "object"
}
