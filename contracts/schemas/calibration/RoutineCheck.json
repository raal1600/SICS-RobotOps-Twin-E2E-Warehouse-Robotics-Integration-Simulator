{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "clues": {
          "items": {
            "type": "string"
          },
          "title": "Clues",
          "type": "array"
        },
        "conclusion": {
          "title": "Conclusion",
          "type": "string"
        },
        "diagnostic_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic Scale"
        },
        "next_measurements": {
          "items": {
            "type": "string"
          },
          "title": "Next Measurements",
          "type": "array"
        },
        "rigid_residual_rms_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rigid Residual Rms Mm"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "default": "Hypothesis comparison only; never changes X, depth scale, tool geometry or approval",
          "title": "Scope",
          "type": "string"
        },
        "similarity_residual_rms_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Residual Rms Mm"
        }
      },
      "required": [
        "conclusion",
        "clues",
        "next_measurements"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "ReferenceValidation": {
      "additionalProperties": false,
      "properties": {
        "error_mm": {
          "minimum": 0,
          "title": "Error Mm",
          "type": "number"
        },
        "error_vector_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Error Vector M",
          "type": "array"
        },
        "expected_base_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Expected Base M",
          "type": "array"
        },
        "predicted_base_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Predicted Base M",
          "type": "array"
        },
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "calibration-1.0",
          "default": "calibration-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "expected_base_m",
        "predicted_base_m",
        "error_vector_m",
        "error_mm"
      ],
      "title": "ReferenceValidation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "check_id": {
      "title": "Check Id",
      "type": "string"
    },
    "diagnostic": {
      "$ref": "#/$defs/Diagnostic"
    },
    "failed_capture_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Capture Ids",
      "type": "array"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "title": "Failures",
      "type": "array"
    },
    "maximum_error_mm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Maximum Error Mm"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reference_count": {
      "title": "Reference Count",
      "type": "integer"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ReferenceValidation"
      },
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": "calibration-1.0",
      "default": "calibration-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "Observes combined RGB/depth-to-base reference accuracy. Does not independently verify the TCP, grasp, flex or robot kinematics.",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "check_id",
    "camera_id",
    "artifact_id",
    "references",
    "failed_capture_ids",
    "passed",
    "failures",
    "maximum_error_mm",
    "reference_count",
    "diagnostic"
  ],
  "title": "RoutineCheck",
  "type": "object"
}
